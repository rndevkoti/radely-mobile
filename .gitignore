android/app/build/
android/build/
git lfs track "*.mp4"
git lfs track "*.zip"
git lfs track "*.tar"

echo "ios/Pods/" >> .gitignore
echo "android/app/build/" >> .gitignore
echo "vendor/bundle/" >> .gitignore